# Environment variables example
# Copy this file to .env and fill in your API keys

# OKX API
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_TESTNET=true

# Binance API
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# BingX API (no testnet available)
BINGX_API_KEY=your_bingx_api_key
BINGX_SECRET_KEY=your_bingx_secret_key

# Gate.io API
GATE_API_KEY=your_gate_api_key
GATE_SECRET_KEY=your_gate_secret_key
GATE_TESTNET=false

# Asterdex API
ASTERDEX_API_KEY=your_asterdex_api_key
ASTERDEX_SECRET_KEY=your_asterdex_secret_key
ASTERDEX_TESTNET=false

# Bybit API
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET_KEY=your_bybit_secret_key
BYBIT_TESTNET=false

# Trading settings
DEFAULT_LEVERAGE=10
AUTO_CLOSE_ON_LIQUIDATION=true
